{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist-web",
        "noEmit": false,
        "sourceMap": true,
        "noEmitOnError": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "dist",
        "dist-web",
        "src/**/*.demo.ts"
    ]
}